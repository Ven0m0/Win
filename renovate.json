{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "abandonments:recommended",
    "group:all",
    "packages:linters",
    ":ignoreModulesAndTests",
    ":enablePreCommit",
    ":preserveSemverRanges"
  ],
  "automerge": true,
  "automergeStrategy": "squash",
  "forkProcessing": "enabled",
  "abandonmentThreshold": "2 years",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "ignoreTests": true,
    "schedule": ["at any time"],
    "automergeSchedule": ["at any time"],
    "minimumReleaseAge": "0 days",
    "dependencyDashboardApproval": false,
    "prCreation": "approval"
  },
  "labels": ["dependencies"],
  "timezone": "Europe/Berlin",
  "platformAutomerge": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rangeStrategy": "bump",
  "constraints": {
    "python": "<3.16"
  },
  "pep621": {
    "enabled": true
  },
  "pep723": {
    "enabled": true
  },
  "pip_requirements": {
    "enabled": false
  },
  "poetry": {
    "enabled": false
  },
  "pipenv": {
    "enabled": false
  },
  "npm": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Disable GitHub Actions digest pinning",
      "matchManagers": ["github-actions"],
      "pinDigests": false
    },
    {
      "description": "Disable Docker digest pinning",
      "matchDatasources": ["docker"],
      "pinDigests": false
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Group pre-commit hooks updates",
      "matchManagers": ["pre-commit"],
      "groupName": "Pre-commit hooks",
      "groupSlug": "pre-commit-hooks"
    },
    {
      "description": "Group mise tool updates",
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "groupSlug": "mise-tools"
    },
    {
      "description": "Group Python package dependencies",
      "matchDatasources": ["pypi"],
      "groupName": "Python dependencies",
      "groupSlug": "python-deps"
    },
    {
      "description": "Restrict mise Python to 3.14.x patch releases only",
      "matchManagers": ["mise"],
      "matchPackageNames": ["python"],
      "allowedVersions": "3.14.x"
    },
    {
      "description": "Apply all eligible updates directly to the base branch without automatic pull requests",
      "matchPackageNames": ["*"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "schedule": ["at any time"],
      "automergeSchedule": ["at any time"],
      "minimumReleaseAge": "0 days",
      "dependencyDashboardApproval": false,
      "prCreation": "approval"
    },
    {
      "description": "Automerge lock file maintenance with an automatic PR fallback",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "platformAutomerge": false,
      "prCreation": "immediate",
      "dependencyDashboardApproval": false,
      "recreateWhen": "always",
      "pruneBranchAfterAutomerge": true
    },
    {
      "description": "Automerge pre-commit hooks with an automatic PR fallback",
      "matchManagers": ["pre-commit"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "platformAutomerge": false,
      "prCreation": "immediate",
      "dependencyDashboardApproval": false,
      "recreateWhen": "always",
      "pruneBranchAfterAutomerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: version=[^\\s]+)?\\s+[A-Za-z0-9_]+_VERSION:\\s*['\"]?(?<currentValue>[^'\"\\s]+)['\"]?"
      ]
    }
  ],
  "automergeType": "branch",
  "ignoreTests": true,
  "schedule": ["at any time"],
  "automergeSchedule": ["at any time"],
  "minimumReleaseAge": "0 days",
  "dependencyDashboardApproval": false,
  "prCreation": "approval",
  "configMigration": false,
  "branchConcurrentLimit": 0,
  "vulnerabilityAlerts": {
    "prCreation": "approval"
  }
}
