Windows Registry Editor Version 5.00

; ============================================================
; Enable GPU Preemption (restore Windows/driver defaults)
; Deletes the values set by disable-preemption.reg
; Preemption allows the GPU to switch between tasks
; ============================================================

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\nvlddmkm]

"DisablePreemption"=-

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\nvlddmkm\Parameters]

"DisablePreemption"=-

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\GraphicsDrivers\Scheduler]

"EnablePreemption"=-
