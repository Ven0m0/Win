Windows Registry Editor Version 5.00

; ============================================================
; Disable NVIDIA Image Scaling (NIS) - New Version
; 0 = legacy Image Sharpening (not NIS), driver 535+
; Written to both FTS keys, as nvidia-settings.ps1 does
; ============================================================

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\nvlddmkm\FTS]

"EnableGR535"=dword:00000000

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\nvlddmkm\Parameters\FTS]

"EnableGR535"=dword:00000000
