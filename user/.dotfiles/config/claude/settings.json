{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"cleanupPeriodDays": 7,
	"env": {
		"CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
		"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
		"CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
		"DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
		"CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "3",
		"CLAUDE_CODE_AUTOCOMPACT_PCT_OVERRIDE": "50",
		"ENABLE_TOOL_SEARCH": "true",
		"ENABLE_LSP_TOOL": "1",
		"USE_BUILTIN_RIPGREP": "1",
		"PYTHONOPTIMIZE": "1",
		"BUN_OPTIONS": "--bun --prefer-offline --prefer-latest --silent",
		"CONTEXT_MODE_NO_BUN": "1",
		"CLAUDE_CODE_NO_FLICKER": "1",
		"ENABLE_PROMPT_CACHING_1H": "1",
		"DISABLE_TELEMETRY": "1",
		"DISABLE_ERROR_REPORTING": "1",
		"DISABLE_AUTOUPDATER": "1",
		"DISABLE_BUG_COMMAND": "1",
		"MAX_THINKING_TOKENS": "10000",
		"BASH_DEFAULT_TIMEOUT_MS": "120000",
		"BASH_MAX_TIMEOUT_MS": "600000",
		"BASH_MAX_OUTPUT_LENGTH": "65536",
		"MCP_TIMEOUT": "60000",
		"MCP_TOOL_TIMEOUT": "120000",
		"MAX_MCP_OUTPUT_TOKENS": "15000",
		"CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8000",
		"RTK_TELEMETRY_DISABLED": "1"
	},
	"attribution": {
		"commit": "",
		"pr": ""
	},
	"includeCoAuthoredBy": false,
	"permissions": {
		"allow": [
			"mcp__codegraph__codegraph_explore",
			"mcp__codegraph__codegraph_search",
			"mcp__codegraph__codegraph_node",
			"mcp__codegraph__codegraph_callers",
			"mcp__codegraph__codegraph_callees",
			"mcp__codegraph__codegraph_impact",
			"mcp__codegraph__codegraph_files",
			"mcp__codegraph__codegraph_status",
			"mcp__obsidian-hybrid-search__search",
			"mcp__obsidian-hybrid-search__read",
			"mcp__obsidian-hybrid-search__status",
			"mcp__obsidian-hybrid-search__reindex",
			"PowerShell",
			"WebSearch",
			"WebFetch(domain:*)",
			"Bash(ssh *)",
			"Bash(ssh-keygen -F *)",
			"Bash(ssh-add -l)",
			"Bash(rtk:*)",
			"Bash(gh:*)"
		],
		"deny": [
			"Edit(./.env)",
			"Edit(./.env.*)",
			"Edit(./secrets/**)",
			"NotebookEdit",
			"Read(**/*.key)",
			"Read(**/*.pem)",
			"Read(**/credentials.json)",
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(./secrets/**)",
			"mcp__plugin_playwright_playwright__browser_install",
			"mcp__plugin_playwright_playwright__browser_navigate"
		],
		"ask": [
			"Bash(chmod:*)",
			"Bash(git clean -fd:*)",
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git reset --hard:*)",
			"Bash(npm publish:*)",
			"Bash(rm -rf:*)",
			"Bash(sudo:*)"
		],
		"defaultMode": "auto"
	},
	"model": "opusplan",
	"enableAllProjectMcpServers": true,
	"skillOverrides": {
		"merge-to-main": "user-invocable-only",
		"repo-janitor": "user-invocable-only",
		"dead-code-cleanup": "user-invocable-only",
		"find-skills": "user-invocable-only",
		"strategic-planning": "user-invocable-only",
		"bedrock-world-backup": "user-invocable-only",
		"agent-browser": "name-only",
		"playwright-cli": "name-only",
		"todo-scan": "user-invocable-only",
		"win-patterns": "name-only",
		"ps-script-validator": "name-only",
		"ps-dedupe-cleanup": "name-only",
		"new-ps-script": "name-only",
		"bedrock-db-query": "name-only",
		"mc-repack-optimize": "user-invocable-only",
		"adb": "user-invocable-only"
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write|Bash|PowerShell",
				"hooks": [
					{
						"type": "command",
						"command": "pwsh -nop -nol -f \"$HOME/.claude/hooks/guard-bedrock-db.ps1\"",
						"timeout": 10,
						"statusMessage": "Checking Bedrock world file safety..."
					}
				]
			},
			{
				"matcher": "Bash|PowerShell",
				"hooks": [
					{
						"type": "command",
						"command": "if (Get-Command rtk -ErrorAction SilentlyContinue) { & rtk hook claude }",
						"shell": "powershell"
					},
					{
						"type": "command",
						"command": "pwsh -nop -nol -f \"$HOME/.claude/hooks/rtk-advisor.ps1\"",
						"timeout": 10,
						"statusMessage": "Checking rtk coverage..."
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "$p = Join-Path $env:USERPROFILE '.caveman/bin/caveman-proxy.exe'; $a = Join-Path $env:APPDATA 'npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'; if ((Test-Path $p) -and (Test-Path $a)) { & $p native-hook claude --adapter $a }",
						"shell": "powershell",
						"timeout": 30
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "$c = Join-Path $env:APPDATA 'npm/caveman.CMD'; if (Test-Path $c) { & $c shrink-hook }",
						"shell": "powershell",
						"timeout": 30
					}
				]
			},
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "Write-Host 'WARNING: Editing a registry file. Verify a restore point exists before applying.'",
						"if": "Edit(**/*.reg)",
						"shell": "powershell",
						"timeout": 10,
						"statusMessage": "Registry file - verify restore point exists"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "& \"$env:USERPROFILE/.claude/hooks/validate-edit.ps1\"",
						"shell": "powershell",
						"timeout": 90,
						"statusMessage": "Validating edited file..."
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "$p = Join-Path $env:USERPROFILE '.caveman/bin/caveman-proxy.exe'; $a = Join-Path $env:APPDATA 'npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'; if ((Test-Path $p) -and (Test-Path $a)) { & $p native-hook claude --adapter $a }",
						"shell": "powershell",
						"timeout": 30
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "[ -f \"$HOME/.claude/hooks/context-mode-cache-heal.mjs\" ] && node \"$HOME/.claude/hooks/context-mode-cache-heal.mjs\" || true"
					},
					{
						"type": "command",
						"command": "[ -f \"$HOME/.claude/hooks/context-mode-no-webfetch.mjs\" ] && node \"$HOME/.claude/hooks/context-mode-no-webfetch.mjs\" || true"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "$vault = Join-Path $env:USERPROFILE 'Nextcloud\\obsidian-vault'; if (-not (Test-Path -LiteralPath $vault)) { exit 0 }; $cwd = if ($env:CLAUDE_PROJECT_DIR) { $env:CLAUDE_PROJECT_DIR } else { (Get-Location).Path }; if ($cwd.TrimEnd('\\') -ne $vault.TrimEnd('\\')) { $m = \"MANDATORY: canonical memory is the Obsidian vault at $vault (see global CLAUDE.md #Memory). Before ending this task, write any durable learning (preference, decision+why, root-caused bug, correction, worked-out topic) as an atomic note there -- don't wait to be asked.\"; @{ hookSpecificOutput = @{ hookEventName = 'SessionStart'; additionalContext = $m } } | ConvertTo-Json -Compress }",
						"shell": "powershell",
						"timeout": 10,
						"statusMessage": "Checking second-brain vault"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "$p = Join-Path $env:USERPROFILE '.caveman/bin/caveman-proxy.exe'; $a = Join-Path $env:APPDATA 'npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'; if ((Test-Path $p) -and (Test-Path $a)) { & $p native-hook claude --adapter $a }",
						"shell": "powershell",
						"timeout": 30
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "if (Get-Command codegraph -ErrorAction SilentlyContinue) { & codegraph prompt-hook }",
						"shell": "powershell",
						"timeout": 20
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "$p = Join-Path $env:USERPROFILE '.caveman/bin/caveman-proxy.exe'; $a = Join-Path $env:APPDATA 'npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'; if ((Test-Path $p) -and (Test-Path $a)) { & $p native-hook claude --adapter $a }",
						"shell": "powershell",
						"timeout": 30
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$p = Join-Path $env:USERPROFILE '.caveman/bin/caveman-proxy.exe'; $a = Join-Path $env:APPDATA 'npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'; if ((Test-Path $p) -and (Test-Path $a)) { & $p native-hook claude --adapter $a }",
						"shell": "powershell",
						"timeout": 30
					}
				]
			}
		],
		"PreCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$p = Join-Path $env:USERPROFILE '.caveman/bin/caveman-proxy.exe'; $a = Join-Path $env:APPDATA 'npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'; if ((Test-Path $p) -and (Test-Path $a)) { & $p native-hook claude --adapter $a }",
						"shell": "powershell",
						"timeout": 30
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$p = Join-Path $env:USERPROFILE '.caveman/bin/caveman-proxy.exe'; $a = Join-Path $env:APPDATA 'npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'; if ((Test-Path $p) -and (Test-Path $a)) { & $p native-hook claude --adapter $a }",
						"shell": "powershell",
						"timeout": 30
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$p = Join-Path $env:USERPROFILE '.caveman/bin/caveman-proxy.exe'; $a = Join-Path $env:APPDATA 'npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'; if ((Test-Path $p) -and (Test-Path $a)) { & $p native-hook claude --adapter $a }",
						"shell": "powershell",
						"timeout": 30
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$p = Join-Path $env:USERPROFILE '.caveman/bin/caveman-proxy.exe'; $a = Join-Path $env:APPDATA 'npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'; if ((Test-Path $p) -and (Test-Path $a)) { & $p native-hook claude --adapter $a }",
						"shell": "powershell",
						"timeout": 30
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$p = Join-Path $env:USERPROFILE '.caveman/bin/caveman-proxy.exe'; $a = Join-Path $env:APPDATA 'npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'; if ((Test-Path $p) -and (Test-Path $a)) { & $p native-hook claude --adapter $a }",
						"shell": "powershell",
						"timeout": 30
					}
				]
			}
		]
	},
	"enableWorkflows": true,
	"workflowKeywordTriggerEnabled": false,
	"statusLine": {
		"type": "command",
		"command": "[ -f \"$HOME/.claude/hud/omc-hud.mjs\" ] && node \"$HOME/.claude/hud/omc-hud.mjs\""
	},
	"enabledPlugins": {
		"superpowers@claude-plugins-official": false,
		"skill-creator@claude-plugins-official": true,
		"github@claude-plugins-official": false,
		"claude-md-management@claude-plugins-official": true,
		"claude-code-setup@claude-plugins-official": true,
		"rust-analyzer-lsp@claude-plugins-official": true,
		"basedpyright@claude-code-lsps": true,
		"vscode-langservers@claude-code-lsps": true,
		"vtsls@claude-code-lsps": true,
		"ponytail@ponytail": true,
		"context-mode@context-mode": true,
		"ty@claude-code-lsps": false,
		"oh-my-claudecode@omc": true,
		"caveman@caveman": true,
		"remember@claude-plugins-official": false,
		"bash-language-server@claude-code-lsps": false,
		"chrome-devtools-mcp@claude-plugins-official": false,
		"clangd-lsp@claude-plugins-official": false,
		"browser-use@claude-plugins-official": false,
		"mdbase-lsp@claude-code-lsps": false,
		"jdtls@claude-code-lsps": false,
		"cli-anything@cli-anything": true,
		"desktop-commander@claude-plugins-official": true,
		"playwright@claude-plugins-official": true,
		"powershell-editor-services@claude-config-marketplace": true,
		"conserve@claude-night-market": true,
		"jdtls-lsp@claude-plugins-official": true,
		"exa-deep-research@anthropic-plugin-directory": true
	},
	"extraKnownMarketplaces": {
		"context-mode": {
			"source": {
				"source": "github",
				"repo": "mksglu/context-mode"
			}
		},
		"oh-my-claudecode": {
			"source": {
				"source": "github",
				"repo": "Yeachan-Heo/oh-my-claudecode"
			}
		},
		"claude-code-lsps": {
			"source": {
				"source": "github",
				"repo": "Piebald-AI/claude-code-lsps"
			}
		},
		"ponytail": {
			"source": {
				"source": "github",
				"repo": "DietrichGebert/ponytail"
			}
		},
		"caveman": {
			"source": {
				"source": "github",
				"repo": "JuliusBrussee/caveman"
			}
		},
		"cli-anything": {
			"source": {
				"source": "github",
				"repo": "HKUDS/CLI-Anything"
			}
		},
		"claude-config-marketplace": {
			"source": {
				"source": "github",
				"repo": "Ven0m0/claude-config"
			}
		},
		"claude-night-market": {
			"source": {
				"source": "github",
				"repo": "athola/claude-night-market"
			}
		}
	},
	"alwaysThinkingEnabled": false,
	"modelSettings": {
		"claude-opus-5-5": {
			"effortLevel": "high"
		},
		"claude-sonnet-5": {
			"effortLevel": "high"
		},
		"claude-sonnet-5-5": {
			"effortLevel": "high"
		}
	},
	"askUserQuestionTimeout": "never",
	"autoUpdatesChannel": "latest",
	"tui": "fullscreen",
	"voice": {
		"enabled": false,
		"mode": "hold"
	},
	"prefersReducedMotion": true,
	"autoMemoryEnabled": true,
	"skipDangerousModePermissionPrompt": true,
	"skipWorkflowUsageWarning": true,
	"theme": "dark",
	"autoCompactEnabled": true,
	"teammateMode": "auto",
	"voiceEnabled": false,
	"autoUpdates": false
}
